# ============================================================
# RAG Bot — пример конфигурации
# Скопируйте: cp example.env .env  (в корне проекта или в web/)
# ============================================================

# --- Провайдер LLM ---
# proxy (основной) или gigachat
LLM_PROVIDER=proxy

# --- ProxyAPI (основной провайдер) ---
PROXY_API_URL=https://api.proxyapi.ru/openai/v1
PROXY_API_KEY=your_proxy_api_key_here
PROXY_EMBED_MODEL=text-embedding-3-small
PROXY_CHAT_MODEL=gpt-4o-mini
PROXY_VISION_MODEL=gpt-4o-mini

# --- GigaChat (альтернативный провайдер) ---
# Получить ключ: https://developers.sber.ru/docs/ru/gigachat/quickstart/main
GIGACHAT_CREDENTIALS=your_gigachat_credentials_here
GIGACHAT_VERIFY_SSL_CERTS=false
GIGACHAT_CHAT_MODEL=GigaChat
GIGACHAT_EMBED_MODEL=Embeddings

# --- RAG настройки ---
TOP_K_RESULTS=3
MAX_CONTEXT_LENGTH=3000
MAX_HISTORY_LENGTH=10
REQUEST_TIMEOUT=60

# --- Веб-сервер ---
HOST=127.0.0.1
PORT=8000

# --- Логирование ---
LOG_LEVEL=INFO
